FROM node:22-bookworm-slim

# Pin exact, current CLI versions instead of mutable `latest`/`stable` tags so
# the runtime image stays reproducible while still tracking the current tested
# host/runtime contract.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        ffmpeg \
        file \
        git \
        jq \
        less \
        lsof \
        openssh-client \
        poppler-utils \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        tini \
        tree \
        unzip \
        xz-utils \
        zip \
        zstd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ARG CODEX_VERSION=0.144.3
RUN npm install -g "@openai/codex@${CODEX_VERSION}"

ARG OPENCODE_VERSION=1.17.18
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}"

ARG HERMES_AGENT_VERSION=0.18.2
RUN python3 -m venv /opt/hermes-agent \
    && /opt/hermes-agent/bin/pip install --no-cache-dir "hermes-agent[acp]==${HERMES_AGENT_VERSION}" \
    && ln -s /opt/hermes-agent/bin/hermes /usr/local/bin/hermes

RUN npm ls -g @openai/codex opencode-ai --depth=0 --json \
    | jq -e \
        --arg codex_version "${CODEX_VERSION}" \
        --arg opencode_version "${OPENCODE_VERSION}" \
        '.dependencies["@openai/codex"].version == $codex_version and .dependencies["opencode-ai"].version == $opencode_version' \
        >/dev/null \
    && hermes --version \
    && hermes acp --check

RUN useradd --create-home --shell /bin/bash lionclaw

USER lionclaw
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
